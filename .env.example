# Copie para .env. Todas são opcionais: cada requisição pode trazer a própria chave.
# Com chaves aqui, quem acessar a API usa a sua cota: não exponha o servidor sem proteção.
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
OPENAI_API_KEY=
DEEPSEEK_API_KEY=

# Provedor usado quando a requisição não informa X-LLM-Provider.
LLM_PROVIDER=anthropic
# LLM_MODEL=claude-sonnet-5-5
